1          /*===================================================================================
2             Macro RRC - measurement error correction for time-varying exposures
3             for Cox Proportional Hazard model.
4          
5            This macro can be used for
6          
7            1: time-varying cumulative average exposure
8            2: b~a-month moving average exposure
9            3: time-varying cumulative total exposure
10           4: time-varying point exposure
11           5: time-independent exposure
12         
13           Residual method is not recommended for the analysis anymore. Please use residual=0 if possible.
14         
15         ===================================================================================*/
16         
17         
18         %macro rrc
19         (
20         id=,                /* Variable name of ID, required */
21         main=,              /* Name of main dataset, required */
22         validation=,        /* Name of validation dataset, required */
23         surrogate=,         /* exposure with error in main dataset, required */
24         true=,              /* exposure without error in main and validation dataset, required */
25         confounder= ,       /* covariates adjusted in the model, optional */
26         extravariableinval=,   /* extra variables included in the measurement error model, NOT in the primary regression
26       ! model*/
27         extravariableinmain=, /* extra variables included in the primary regression model, NOT in the measurement error
27       ! model */
28         case= ,             /* variable that indicates whether an event occurs or not, required */
29         time= ,             /* variable for time-to-event outcome, required */
30         missing=,           /* missing indicator, new added */
31         period=,            /* period indicator for exposure, new added */
32         groupnum=5,         /* the minimum number of subjects in each risk set, optional,  default=5 */
33         increments=1,       /* the unit of expsoure, optional, default=1 */
2                                                      The SAS System                         14:54 Monday, December 13, 2021

34         type=1,             /* type of data,
35                                1: time-varying cumulative average exposure
36                                2: b~a-month moving average exposure
37                                3: time-varying cumulative total exposure
38                                4: time-varying point exposure
39                                5: time-independent exposure */
40         month=12,           /* for 12-month average exposure with month1=1, could be any other integer */
41         month1=1,           /* for b~a-month moving average exposure. could be any other integer and month1<month */
42         emodel=1,           /* if model=1, it assumes general linear measurement error model;
43                                if model=2, it assumes additive measurement error model.
44                                only required for type=1. */
45         icc=,               /* the correlation of repeated measurements of true exposure,
46                                only required for type=1, emodel=2 */
47         dampfactor=,        /* the damp factor of the covariance matrix for true expsoure, only required for type=1,
47       ! emodel=2*/
48         timestart=,         /* the start of follow-up time, for time-independent exposure, only required for type=5*/
49         timeend=,           /* the end of follow-up time, for time-independent exposure, only required for type=5*/
50         residual=0,         /* if residual=1,do residual analysis for dimension reduction; otherwise, residual=0,*/
51         initialvalue=,     /* the initial value for all the exposure and covariates */
52         xupper=,          /* the upper bound for all the exposure and covariates */
53         xlower=,         /* the lower bound for all the exposure and covariates */
54         filename=RRCOutput.txt,   /*filename for the output file*/
55         csvfilename=none,       /* filename for CSV output */
56         path=/tmp,                 /* path to directory to put data files, you can use . to output everything in your own
56       ! directory */
57         
58         /* The following option is only for Type=2 now */
59         
60         truepredict=, /* Name of the variable for predicted true value */
61         surrogatefunc=,  /* Name of the variable for the function (such as 12 month) of surroagte exposure for output */
62         outdata=  /* Name of the output data for the main study with both the surrogate and the predicted true exposure */
63         );
64         
65         /* Check some arguments */
66         %let nex=%sysfunc(countw(&true,' '));
67         %let nexs=%sysfunc(countw(&surrogate,' '));
68         %let ncovm=%sysfunc(countw(&confounder,' '));
69         %let ncove=%sysfunc(countw(&extravariableinval,' '));
70         %let ncovem=%sysfunc(countw(&extravariableinmain,' '));
71         
72         %if &type ne 2 %then %do;
73             %let ncov=%sysfunc(countw(&confounder,' '));
74         %end;
75         
76         %if &nex^=&nexs %then %goto out1;
77         %if &nex=0 or &nexs=0 %then %goto out4;
78         %let in_main=%sysfunc(countw(&main,' '));
79         %if &in_main=0 %then %goto out2;
80         %let in_vali=%sysfunc(countw(&validation,' '));
81         %if &in_vali=0 %then %goto out3;
82         
83         /*indicator for residual analysis*/
84         %let isres=0;
85         
86         data mainy0;
87         %if &type=5 %then %do;
88             set &main;
89             do &time=&timestart to &timeend;
90                 if &timestart<&timeend then do;
91                     if &time<&timeend then casenew=0;
92                     if &time=&timeend then casenew=&case;
93                     end;
94                 else do;
95                     casenew=&case;
96                     end;
97                 output;
98             end;
99         %end;
100        %else %do;
101         set &main;
102         casenew=&case;
103        %end;
104        run;
